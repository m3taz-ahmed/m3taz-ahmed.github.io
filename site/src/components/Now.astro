---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="now" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.now.title} />
    <div class="max-w-4xl mx-auto glass-card reveal">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-xs text-muted uppercase tracking-widest">{t.now.available}</span>
      </div>
      <p class="text-fg leading-relaxed mb-4" set:html={t.now.body} />
      <ul class="list-disc ps-5 space-y-2 text-muted text-sm mb-4">
        {t.now.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="text-sm text-muted">{t.now.updated}</p>
    </div>
  </div>
</section>
