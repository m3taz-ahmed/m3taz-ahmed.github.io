---
import { getTranslations, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

const phrases = JSON.stringify(t.hero.typewriter);
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-24 pb-12">
  <div class="absolute top-0 end-0 w-1/2 h-full radial-glow pointer-events-none z-0" aria-hidden="true"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3 text-center lg:text-start">
        <span class="inline-block font-mono text-xs text-primary tracking-widest uppercase bg-primary/10 px-3 py-1 rounded mb-4">
          {t.hero.nameTag}
        </span>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-fg whitespace-pre-line">
          {
            t.hero.title.map((part) => (
              <span class={part.gradient ? 'gradient-text' : ''}>{part.text}</span>
            ))
          }
        </h1>

        <div class="mt-6 flex flex-col items-center lg:items-start">
          <h2
            class="hero-name text-3xl sm:text-4xl md:text-5xl font-black text-muted/30 relative inline-block"
            data-text={t.hero.name}
            style="-webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 30%, transparent);"
          >
            {t.hero.name}
          </h2>

          <p class="mt-4 text-lg md:text-xl text-muted font-mono">
            {t.hero.subtitle}
            <span id="typewriter" class="text-primary blink" data-phrases={phrases}></span>
          </p>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="#projects" class="btn btn-primary">
            {t.hero.ctaPrimary}
          </a>
          <a href="/assets/Moataz-Ahmed-Resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            {t.hero.ctaSecondary}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              <path d="M12 18v-6"/>
              <path d="m9 15 3 3 3-3"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-2 flex justify-center">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80">
          <img
            src="/assets/moataz-ahmed-pic.jpg"
            alt={t.hero.name}
            class="w-full h-full object-cover morph border-4 border-border shadow-2xl relative z-10"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="320"
            height="320"
          />
          <div
            class="absolute -inset-4 border-2 border-primary/30 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] rotating -z-0"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>
