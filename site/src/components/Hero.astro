---
import { getTranslations, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

const phrases = JSON.stringify(t.hero.typewriter);
---

<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
  <div class="absolute top-0 end-0 w-1/2 h-full bg-radial-gradient pointer-events-none z-0" aria-hidden="true"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3 text-center lg:text-start">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight text-white whitespace-pre-line"
        >
          {
            t.hero.title.map((part) => (
              <span class={part.gradient ? 'gradient-text' : ''}>
                {part.text}
              </span>
            ))
          }
        </h1>

        <div class="mt-8 flex flex-col items-center lg:items-start">
          <span class="font-mono text-xs text-primary tracking-widest uppercase bg-primary/10 px-3 py-1 rounded mb-2">
            {t.hero.nameTag}
          </span>

          <h2
            class="hero-name text-3xl sm:text-4xl md:text-5xl font-black text-white/10 relative inline-block"
            data-text={t.hero.name}
            style="-webkit-text-stroke: 1px rgba(255,255,255,0.3);"
          >
            {t.hero.name}
          </h2>

          <p class="mt-4 text-lg md:text-xl text-dim font-mono">
            {t.hero.subtitle}
            <span id="typewriter" class="text-primary blink" data-phrases={phrases}></span>
          </p>
        </div>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="#projects" class="btn btn-primary magnetic">
            {t.hero.ctaPrimary}
          </a>
          <a href="/assets/Moataz-Ahmed-Resume.pdf" target="_blank" class="btn btn-outline magnetic">
            {t.hero.ctaSecondary}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
              <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
              <path d="M12 18v-6"/>
              <path d="m9 15 3 3 3-3"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-2 flex justify-center">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80">
          <img
            src="/assets/moataz-ahmed-pic.jpg"
            alt={t.hero.name}
            class="w-full h-full object-cover morph border-4 border-white/10 shadow-2xl relative z-10"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div
            class="absolute -inset-4 border-2 border-primary/30 rounded-[30%_70%_70%_30%/30%_30%_70%_70%] rotating -z-0"
            aria-hidden="true"
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-radial-gradient {
    background: radial-gradient(circle at 70% 30%, rgba(0, 212, 255, 0.05) 0%, transparent 70%);
  }
</style>
