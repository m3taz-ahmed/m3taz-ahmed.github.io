---
import { getTranslations, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="pipeline" data-station="1" class="section-padding relative">
  <div class="container mx-auto px-6">
    <header class="max-w-3xl mb-14 reveal">
      <div class="flex items-center gap-3 mb-5">
        <span class="station-chip">[ 01 / 06 ]</span>
        <span class="kicker">{t.pipeline.kicker}</span>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-bold text-fg">
        {t.pipeline.title.prefix}<span class="gradient-text">{t.pipeline.title.highlight}</span>
      </h2>
      <p class="mt-5 text-lg text-muted leading-relaxed">{t.pipeline.intro}</p>
    </header>

    <div class="max-w-5xl">
      {t.pipeline.stages.map((stage, i) => (
        <article class="stage reveal md:grid md:grid-cols-2 md:gap-12 md:items-center border-t border-border/60">
          <div class={i % 2 === 1 ? 'md:order-2' : ''}>
            <div class="flex items-center gap-4 mb-3">
              <span class="stage-num">{stage.num}</span>
              <span class="stage-name">{stage.name}</span>
            </div>
            <h3 class="font-display text-2xl md:text-3xl font-semibold text-fg mb-3">{stage.punch}</h3>
            <p class="text-muted leading-relaxed mb-5">{stage.desc}</p>
            <div class="flex flex-wrap gap-2">
              {stage.chips.map((chip) => <span class="tech-tag">{chip}</span>)}
            </div>
          </div>

          <div class={`stage-artifact mt-6 md:mt-0 ${i % 2 === 1 ? 'md:order-1' : ''}`} aria-hidden="true">
            {stage.artifact === 'spec' && (
              <svg viewBox="0 0 320 140">
                <rect x="10" y="10" width="92" height="8" rx="2" fill="var(--border-strong)" class="fade-bit f1" />
                <rect x="230" y="10" width="80" height="8" rx="2" fill="var(--grid-line)" class="fade-bit f2" />
                {[36, 60, 84, 108].map((y, r) => (
                  <g>
                    <circle cx="20" cy={y} r="7" fill="none" stroke="var(--border-strong)" class={`fade-bit f${r + 1}`} />
                    <path d={`M16 ${y} l3 3 l6 -6`} fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" class={`draw-path d${r + 1}`} />
                    <rect x="38" y={y - 4} width={[200, 160, 228, 130][r]} height="7" rx="3.5" fill="var(--border)" class={`fade-bit f${r + 2}`} />
                    <rect x={246} y={y - 4} width="42" height="7" rx="3.5" fill="color-mix(in srgb, var(--primary) 30%, transparent)" class={`fade-bit f${r + 3}`} />
                  </g>
                ))}
              </svg>
            )}

            {stage.artifact === 'schema' && (
              <svg viewBox="0 0 320 140">
                <path d="M104 46 C 128 46, 128 30, 152 30" fill="none" stroke="var(--primary)" stroke-width="1.4" class="draw-path" />
                <path d="M104 66 C 128 66, 128 104, 152 104" fill="none" stroke="var(--primary)" stroke-width="1.4" class="draw-path d2" />
                <g class="fade-bit f1">
                  <rect x="10" y="34" width="94" height="44" rx="6" fill="none" stroke="var(--border-strong)" />
                  <rect x="10" y="34" width="94" height="16" rx="6" fill="color-mix(in srgb, var(--primary) 18%, transparent)" />
                  <text x="20" y="45" class="console-artifact" fill="var(--fg)">users</text>
                  <line x1="20" y1="60" x2="88" y2="60" stroke="var(--border)" />
                  <line x1="20" y1="70" x2="76" y2="70" stroke="var(--border)" />
                </g>
                <g class="fade-bit f2">
                  <rect x="152" y="14" width="104" height="32" rx="6" fill="none" stroke="var(--border-strong)" />
                  <rect x="152" y="14" width="104" height="14" rx="6" fill="color-mix(in srgb, var(--secondary) 20%, transparent)" />
                  <text x="162" y="24" class="console-artifact" fill="var(--fg)">bookings</text>
                  <line x1="162" y1="36" x2="238" y2="36" stroke="var(--border)" />
                </g>
                <g class="fade-bit f3">
                  <rect x="152" y="88" width="104" height="32" rx="6" fill="none" stroke="var(--border-strong)" />
                  <rect x="152" y="88" width="104" height="14" rx="6" fill="color-mix(in srgb, var(--secondary) 20%, transparent)" />
                  <text x="162" y="98" class="console-artifact" fill="var(--fg)">payments</text>
                  <line x1="162" y1="110" x2="238" y2="110" stroke="var(--border)" />
                </g>
                <circle cx="104" cy="46" r="3" fill="var(--primary)" class="fade-bit f4" />
                <circle cx="104" cy="66" r="3" fill="var(--primary)" class="fade-bit f5" />
                <text x="266" y="34" class="console-artifact" fill="var(--muted)">1:N</text>
                <text x="266" y="108" class="console-artifact" fill="var(--muted)">1:N</text>
              </svg>
            )}

            {stage.artifact === 'wireframe' && (
              <svg viewBox="0 0 320 140">
                <rect x="8" y="8" width="304" height="124" rx="8" fill="none" stroke="var(--border-strong)" class="fade-bit f1" />
                <line x1="8" y1="30" x2="312" y2="30" stroke="var(--border)" class="fade-bit f1" />
                <circle cx="20" cy="19" r="3" fill="var(--border-strong)" class="fade-bit f2" />
                <circle cx="30" cy="19" r="3" fill="var(--border-strong)" class="fade-bit f2" />
                <rect x="20" y="42" width="120" height="12" rx="4" fill="var(--fg)" opacity="0.85" class="fade-bit f2" />
                <rect x="20" y="60" width="180" height="7" rx="3.5" fill="var(--border)" class="fade-bit f3" />
                <rect x="20" y="72" width="150" height="7" rx="3.5" fill="var(--border)" class="fade-bit f3" />
                <rect x="20" y="92" width="76" height="22" rx="11" fill="var(--primary)" class="fade-bit f4" />
                <rect x="216" y="42" width="84" height="72" rx="6" fill="none" stroke="var(--primary)" stroke-dasharray="4 4" class="fade-bit f5" />
                <path d="M228 96 l14 -18 l10 12 l16 -22 l20 28" fill="none" stroke="var(--primary)" stroke-width="1.5" class="draw-path d4" />
              </svg>
            )}

            {stage.artifact === 'commits' && (
              <svg viewBox="0 0 320 140">
                <path d="M20 60 H300" fill="none" stroke="var(--border-strong)" stroke-width="1.6" class="draw-path" />
                <path d="M96 60 C 116 60, 116 102, 140 102 H196 C 220 102, 220 60, 236 60" fill="none" stroke="var(--secondary)" stroke-width="1.6" class="draw-path d2" />
                {[
                  { x: 44, y: 60, c: 'f1' },
                  { x: 96, y: 60, c: 'f2' },
                  { x: 168, y: 102, c: 'f3', branch: true },
                  { x: 236, y: 60, c: 'f4' },
                  { x: 288, y: 60, c: 'f5' },
                ].map((n) => (
                  <g class={`fade-bit ${n.c}`}>
                    <circle cx={n.x} cy={n.y} r="7" fill="var(--bg)" stroke={n.branch ? 'var(--secondary)' : 'var(--primary)'} stroke-width="2" />
                    <circle cx={n.x} cy={n.y} r="2.5" fill={n.branch ? 'var(--secondary)' : 'var(--primary)'} />
                  </g>
                ))}
                <text x="44" y="42" class="console-artifact" fill="var(--muted)" text-anchor="middle">feat</text>
                <text x="168" y="122" class="console-artifact" fill="var(--muted)" text-anchor="middle">fix/rbac</text>
                <text x="288" y="42" class="console-artifact" fill="var(--accent)" text-anchor="middle">v1.0 ✓</text>
              </svg>
            )}

            {stage.artifact === 'uptime' && (
              <svg viewBox="0 0 320 140">
                {[30, 62, 94].map((y) => (
                  <line x1="10" y1={y} x2="310" y2={y} stroke="var(--grid-line)" stroke-dasharray="3 5" class="fade-bit f1" />
                ))}
                <path d="M14 104 L52 100 L86 106 L118 68 L150 96 L186 90 L218 46 L252 74 L306 40" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linejoin="round" class="draw-path" />
                <circle cx="306" cy="40" r="5" fill="var(--accent)" class="fade-bit f3" />
                <circle cx="306" cy="40" r="5" fill="none" stroke="var(--accent)" class="fade-bit f3" opacity="0.5">
                  <animate attributeName="r" values="5;11" dur="1.6s" repeatCount="indefinite" />
                  <animate attributeName="opacity" values="0.5;0" dur="1.6s" repeatCount="indefinite" />
                </circle>
                <text x="14" y="30" class="console-stage-label" fill="var(--accent)" font-size="13">99.9%</text>
                <text x="14" y="46" class="console-artifact" fill="var(--muted)">uptime · last 90d</text>
                <text x="306" y="124" class="console-artifact" fill="var(--muted)" text-anchor="end">deploys: green</text>
              </svg>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
