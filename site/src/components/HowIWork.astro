---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="how-i-work" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.howIWork.title} />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        t.howIWork.steps.map((step, index) => (
          <div class="glass-card glass-card-interactive text-center reveal" data-stagger="true">
            <div class="w-14 h-14 mx-auto rounded-full bg-primary/10 border border-border flex items-center justify-center text-primary text-2xl mb-4 transition-transform duration-300 hover:scale-110">
              <Icon name={step.icon} size={28} />
            </div>
            <span class="text-xs font-mono text-muted uppercase tracking-wider mb-2 block">0{index + 1}</span>
            <h3 class="text-lg font-bold text-fg mb-2">{step.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
