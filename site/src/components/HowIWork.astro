---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

---

<section id="how-i-work" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.howIWork.title} />

    <div class="mt-16 flex flex-col lg:flex-row items-start justify-between gap-4 relative">
      {
        t.howIWork.steps.map((step, index) => (
          <>
            <div class="flex-1 text-center reveal glass-card relative overflow-hidden" data-stagger="true">
              <div class="w-16 h-16 mx-auto rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-primary text-2xl mb-4 transition-transform duration-300 hover:scale-110 hover:bg-primary hover:text-white">
                <Icon name={step.icon} size={28} />
              </div>
              <h3 class="text-xl font-bold text-white mb-2">{step.title}</h3>
              <p class="text-dim text-sm leading-relaxed">{step.desc}</p>
            </div>

            {index < t.howIWork.steps.length - 1 && (
              <div class="hidden lg:block flex-[0.15] h-0.5 bg-white/10 mt-8 relative" aria-hidden="true">
                <div class="absolute inset-y-0 start-0 w-full bg-primary" />
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>
</section>

