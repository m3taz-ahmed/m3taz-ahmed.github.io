---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="opensource" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.openSource.title} />

    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
      <!-- aiZee card -->
      <div class="md:col-span-2 glass-card reveal border-t-4 border-t-primary">
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-3">
            <img src="/assets/aizee-logo.png" alt="aiZee" class="w-10 h-10 object-contain bg-white rounded-lg p-1" loading="lazy" />
            <div>
              <h3 class="text-xl font-bold text-fg">aiZee</h3>
              <p class="text-xs text-muted font-mono">github.com/m3taz-ahmed/aizee</p>
            </div>
          </div>
          <span class="tech-tag bg-primary text-primary-fg" data-stat="version">v6.x</span>
        </div>
        <p class="text-muted text-sm leading-relaxed mb-4">
          {t.openSource.aizeeDesc}
        </p>
        <div class="flex flex-wrap gap-2 mb-6" id="aizee-live-stats">
          <span class="tech-tag" data-stat="stars">★ 5</span>
          <span class="tech-tag" data-stat="commits">200+ commits</span>
          <span class="tech-tag" data-stat="tests">7,600+ tests · 100%</span>
          <span class="tech-tag" data-stat="updated">{t.openSource.updated}</span>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="https://github.com/m3taz-ahmed/aizee" target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm py-2 px-4">
            <Icon name="Github" size={16} /> GitHub
          </a>
          <a href="https://github.com/m3taz-ahmed/aizee/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer" class="btn btn-outline text-sm py-2 px-4">
            Changelog
          </a>
        </div>
      </div>

      <!-- GitHub profile snapshot -->
      <div class="glass-card reveal">
        <h3 class="text-lg font-bold text-fg mb-4 flex items-center gap-2"><Icon name="Github" size={18} /> GitHub</h3>
        <div id="github-profile" class="space-y-3 text-sm">
          <div class="flex justify-between"><span class="text-muted">Repos</span><span class="font-bold text-fg" data-gh="repos">16</span></div>
          <div class="flex justify-between"><span class="text-muted">Stars (aiZee)</span><span class="font-bold text-fg" data-gh="stars">5</span></div>
          <div class="flex justify-between"><span class="text-muted">Followers</span><span class="font-bold text-fg" data-gh="followers">2</span></div>
          <div class="h-px bg-border my-3"></div>
          <p class="text-xs text-muted leading-relaxed">
            {t.openSource.reposCount}
          </p>
          <a href="https://github.com/m3taz-ahmed" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary font-medium text-sm hover:gap-3 transition-all">
            {t.openSource.viewProfile} <Icon name="ExternalLink" size={12} />
          </a>
        </div>
        <div class="mt-4 flex flex-wrap gap-1.5">
          <span class="tech-tag text-xs">PHP 8.5</span>
          <span class="tech-tag text-xs">Laravel 13</span>
          <span class="tech-tag text-xs">Python</span>
          <span class="tech-tag text-xs">MCP</span>
        </div>
      </div>
    </div>

    <!-- Case study repos -->
    <div class="max-w-5xl mx-auto mt-6 glass-card reveal">
      <h3 class="text-sm font-bold text-fg mb-3 font-mono uppercase tracking-wider">{t.openSource.caseStudiesTitle}</h3>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3 text-sm">
        <a href="https://github.com/m3taz-ahmed/case-study-skybridge" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">SkyBridge</span><span class="text-muted text-xs">28K bookings</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-raunautica" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">Raunautica</span><span class="text-muted text-xs">Marina OS</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-business-belarabi" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">Belarabi</span><span class="text-muted text-xs">B2B 200+</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-ishraqmed" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">IshraqMed</span><span class="text-muted text-xs">+35% bookings</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-gobook" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">Gobook</span><span class="text-muted text-xs">SaaS</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-gentoura" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">Gentoura</span><span class="text-muted text-xs">AI Travel</span>
        </a>
        <a href="https://github.com/m3taz-ahmed/case-study-internal-audit" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 rounded-lg border border-border hover:border-primary transition-colors">
          <span class="font-medium text-fg">Internal Audit</span><span class="text-muted text-xs">PPC · RBAC</span>
        </a>
      </div>
      <p class="text-xs text-muted mt-3">{t.openSource.caseStudiesDesc}</p>
    </div>
  </div>
</section>

<script is:inline>
  (async () => {
    try {
      const res = await fetch('https://api.github.com/users/m3taz-ahmed');
      if (!res.ok) return;
      const data = await res.json();
      const repos = document.querySelector('[data-gh="repos"]');
      const followers = document.querySelector('[data-gh="followers"]');
      if (repos) repos.textContent = String(data.public_repos ?? 16);
      if (followers) followers.textContent = String(data.followers ?? 2);
      const r2 = await fetch('https://api.github.com/repos/m3taz-ahmed/aizee');
      if (!r2.ok) return;
      const d2 = await r2.json();
      const stars = document.querySelector('[data-gh="stars"]');
      const s1 = document.querySelector('[data-stat="stars"]');
      if (stars) stars.textContent = String(d2.stargazers_count ?? 5);
      if (s1) s1.textContent = `★ ${d2.stargazers_count ?? 5}`;
      const commits = document.querySelector('[data-stat="commits"]');
      // updated_at as freshness
      const upd = document.querySelector('[data-stat="updated"]');
      if (upd && d2.updated_at) {
        const d = new Date(d2.updated_at);
        upd.textContent = d.toISOString().slice(0,7);
      }
      // latest release tag → version badge (never goes stale)
      const r3 = await fetch('https://api.github.com/repos/m3taz-ahmed/aizee/releases/latest');
      if (r3.ok) {
        const d3 = await r3.json();
        const ver = document.querySelector('[data-stat="version"]');
        if (ver && d3.tag_name) ver.textContent = d3.tag_name;
      }
    } catch {}
  })();
</script>
