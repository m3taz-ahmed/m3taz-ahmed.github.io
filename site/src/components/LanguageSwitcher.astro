---
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const otherLocale = locale === 'en' ? 'ar' : 'en';
const otherLabel = locale === 'en' ? 'العربية' : 'English';
const otherUrl = getRelativeLocaleUrl(otherLocale, '/');
---

<a
  href={otherUrl}
  class="text-sm font-medium text-muted hover:text-fg transition-colors border border-border rounded-full px-3 py-1.5 hover:bg-card focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
  aria-label={locale === 'en' ? 'Switch to Arabic' : 'Switch to English'}
>
  {otherLabel}
</a>
