---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

const stats = t.about.stats.map((s, i) => ({ ...s, id: i }));
---

<section id="about" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.about.title} />

    <div class="max-w-4xl mx-auto glass-card reveal">
      <p class="text-xl md:text-2xl text-heading leading-relaxed mb-6">
        {t.about.intro}
      </p>
      <p class="text-dim leading-relaxed mb-8">
        {t.about.body}
      </p>

      <div class="stats-grid grid grid-cols-2 md:grid-cols-4 gap-6 mt-12">
        {
          stats.map((stat) => (
            <div class="text-center reveal">
              <span
                class="stat-number block text-4xl md:text-5xl font-extrabold text-primary"
                data-target={stat.value}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </span>
              <span class="text-dim text-xs uppercase tracking-wider mt-2 block">
                {stat.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="text-center mt-10">
      <a
        href="/assets/Moataz-Ahmed-Resume.pdf"
        target="_blank"
        class="btn btn-outline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" x2="12" y1="15" y2="3"/>
        </svg>
        {t.about.resume}
      </a>
    </div>
  </div>
</section>
