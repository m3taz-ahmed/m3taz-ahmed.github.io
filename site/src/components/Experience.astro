---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="experience" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.experience.title} />

    <div class="max-w-3xl mx-auto relative">
      <div
        class="absolute top-0 bottom-0 w-0.5 bg-border start-5 md:start-8"
        aria-hidden="true"
      ></div>

      {
        t.experience.items.map((item) => (
          <div class="timeline-item relative ps-16 md:ps-24 pb-12 reveal">
            <div
              class="timeline-dot absolute top-1 start-4 md:start-7 w-4 h-4 rounded-full bg-primary shadow-[0_0_10px_var(--primary)]"
              aria-hidden="true"
            ></div>
            <span class="text-primary font-semibold text-sm block mb-1">
              {item.date}
            </span>
            <div class="glass-card">
              <h3 class="text-xl font-bold text-fg mb-1">{item.role}</h3>
              <h4 class="text-primary font-medium mb-4">{item.company}</h4>
              <ul class="space-y-3 text-muted list-disc ps-4">
                {item.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
