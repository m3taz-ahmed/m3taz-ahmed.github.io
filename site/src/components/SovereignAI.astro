---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="sovereign-ai" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.sovereignAI.title} />

    <div class="max-w-4xl mx-auto">
      <div class="glass-card floating text-center border-t-4 border-t-secondary reveal">
        <div class="flex flex-col items-center gap-4 mb-6">
          <img
            src="/assets/ai-os-logo.png"
            alt="AI Global OS"
            class="w-16 h-16 object-contain drop-shadow-[0_0_12px_color-mix(in_srgb,var(--secondary)_30%,transparent)]"
            loading="lazy"
            decoding="async"
            width="64"
            height="64"
          />
          <div>
            <span class="font-mono text-xs text-primary tracking-wider uppercase bg-primary/10 px-2 py-1 rounded">
              {t.sovereignAI.label}
            </span>
            <h3 class="text-2xl md:text-3xl font-bold text-fg mt-2">
              <span class="gradient-text">{t.sovereignAI.version}</span>
            </h3>
          </div>
        </div>

        <p class="text-lg text-fg font-semibold mb-4">
          {t.sovereignAI.headline}
        </p>

        <p class="text-muted leading-relaxed mb-8">
          {t.sovereignAI.description}
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-8">
          {
            t.sovereignAI.tags.map((tag) => (
              <span
                class="tech-tag cursor-help"
                data-level={tag.level}
                data-info={tag.info}
                title={tag.info}
              >
                {tag.label}
              </span>
            ))
          }
        </div>

        <a
          href="https://github.com/m3taz-ahmed/ai-globals"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <Icon name="Github" size={18} />
          {t.sovereignAI.cta}
        </a>
      </div>
    </div>
  </div>
</section>
