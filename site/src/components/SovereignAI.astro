---
import { getTranslations, type Locale } from '../i18n';
import SectionTitle from './SectionTitle.astro';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="sovereign-ai" class="section-padding relative">
  <div class="container mx-auto px-6">
    <SectionTitle title={t.sovereignAI.title} />

    <div class="max-w-4xl mx-auto">
      <div class="glass-card floating text-center border-t-4 border-t-secondary reveal">
        <div class="flex flex-col items-center gap-4 mb-6">
          <img
            src="/assets/aizee-logo.png"
            alt="aiZee — The policy layer for AI coding"
            class="w-40 h-auto object-contain drop-shadow-[0_0_16px_color-mix(in_srgb,var(--secondary)_25%,transparent)] bg-white rounded-xl p-2"
            loading="lazy"
            decoding="async"
            width="160"
            height="64"
          />
          <div>
            <span class="font-mono text-xs text-primary tracking-wider uppercase bg-primary/10 px-2 py-1 rounded">
              {t.sovereignAI.label}
            </span>
            <h3 class="text-2xl md:text-3xl font-bold text-fg mt-2">
              <span class="gradient-text">{t.sovereignAI.version}</span>
            </h3>
            <div class="flex items-center justify-center gap-2 mt-2 font-mono text-xs">
              <span class="tech-tag">{t.sovereignAI.stats.stars}</span>
              <span class="tech-tag">{t.sovereignAI.stats.commits}</span>
              <span class="tech-tag">{t.sovereignAI.stats.tests}</span>
            </div>
          </div>
        </div>

        <p class="text-lg text-fg font-semibold mb-4">
          {t.sovereignAI.headline}
        </p>

        <p class="text-muted leading-relaxed mb-8">
          {t.sovereignAI.description}
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-8">
          {
            t.sovereignAI.tags.map((tag) => (
              <span
                class="tech-tag cursor-help"
                data-level={tag.level}
                data-info={tag.info}
                title={tag.info}
              >
                {tag.label}
              </span>
            ))
          }
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="https://github.com/m3taz-ahmed/ai-globals"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <Icon name="Github" size={18} />
            {t.sovereignAI.cta}
          </a>
          <a
            href="https://github.com/m3taz-ahmed/ai-globals/blob/main/CHANGELOG.md"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline text-sm"
          >
            Changelog v5.7.1
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
