---
import { getTranslations, type Locale } from '../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

const navItems = [
  { href: '#sovereign-ai', label: t.nav.aiOS },
  { href: '#about', label: t.nav.about },
  { href: '#experience', label: t.nav.journey },
  { href: '#projects', label: t.nav.projects },
  { href: '#opensource', label: 'Open Source' },
  { href: '#skills', label: t.nav.stack },
  { href: '#education', label: t.nav.education },
  { href: '#contact', label: t.nav.contact },
];

const homeUrl = getRelativeLocaleUrl(locale, '/');
---

<nav class="fixed top-0 inset-x-0 z-50 border-b border-border bg-bg/70 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between h-20">
    <a href={homeUrl} class="text-xl font-extrabold text-fg tracking-tight focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded">
      <span class="text-muted">[</span>M3TAZ.<span class="gradient-text">AHMED</span><span class="text-muted">]</span>
    </a>

    <ul
      id="nav-links"
      class="hidden lg:flex items-center gap-8 list-none m-0 p-0"
      aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'}
    >
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-muted hover:text-fg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:flex items-center gap-3">
      <LanguageSwitcher />
      <ThemeToggle />
      <a
        href="https://github.com/m3taz-ahmed"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-full text-muted hover:text-fg hover:bg-card transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
      </a>
      <a href={t.contact.info.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm py-2 px-4">
        {t.nav.cta}
      </a>
    </div>

    <div class="flex items-center gap-3 lg:hidden">
      <LanguageSwitcher />
      <ThemeToggle />
      <button
        id="hamburger"
        type="button"
        class="flex flex-col justify-center gap-1.5 w-10 h-10 bg-transparent border-0 p-0 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="nav-links-mobile"
      >
        <span class="block w-6 h-0.5 bg-fg transition-all duration-300 origin-center"></span>
        <span class="block w-6 h-0.5 bg-fg transition-all duration-300 origin-center"></span>
        <span class="block w-6 h-0.5 bg-fg transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </div>

  <div
    id="nav-links-mobile"
    class="lg:hidden fixed inset-0 top-20 bg-bg/95 backdrop-blur-xl z-40 transform translate-x-full transition-transform duration-300"
    aria-hidden="true"
  >
    <ul class="flex flex-col items-center justify-center h-full gap-6 list-none m-0 p-0">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="text-xl font-medium text-fg hover:text-primary transition-colors">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={t.contact.info.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-4">
          {t.nav.cta}
        </a>
      </li>
    </ul>
  </div>
</nav>
