---
import { getTranslations, type Locale } from '../i18n';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<section id="profile" data-station="3" class="section-padding relative">
  <div class="container mx-auto px-6">
    <header class="max-w-3xl mb-14 reveal">
      <div class="flex items-center gap-3 mb-5">
        <span class="station-chip">[ 03 / 06 ]</span>
        <span class="kicker">{t.profile.kicker}</span>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-bold text-fg">
        {t.profile.title.prefix}<span class="gradient-text">{t.profile.title.highlight}</span>
      </h2>
    </header>

    <div class="max-w-6xl grid lg:grid-cols-12 gap-8">
      <!-- Bio column -->
      <div class="lg:col-span-7">
        <div class="glass-card reveal h-full">
          <p class="text-xl md:text-2xl font-display font-semibold text-fg leading-snug">{t.profile.intro}</p>
          <p class="mt-5 text-muted leading-relaxed">{t.profile.body}</p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/assets/Moataz-Ahmed-CV.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm py-2.5 px-5">
              <Icon name="FileDown" size={16} /> {t.profile.resume}
            </a>
            <a href="/assets/Moataz-Ahmed-CV.html" target="_blank" rel="noopener noreferrer" class="btn btn-outline text-sm py-2.5 px-5">
              {t.profile.resumeOnline}
            </a>
          </div>

          <div class="mt-7 pt-5 border-t border-border flex flex-wrap gap-x-6 gap-y-2">
            <span class="mono-note"><span class="text-primary">▸</span> {t.profile.verify.repos}</span>
            <span class="mono-note"><span class="text-primary">▸</span> {t.profile.verify.since}</span>
            <span class="mono-note"><span class="text-primary">▸</span> {t.profile.verify.langs}</span>
          </div>
        </div>
      </div>

      <!-- Record column — audit log -->
      <div class="lg:col-span-5">
        <div class="glass-card reveal">
          <div class="mono-note mb-3 text-primary">{t.profile.recordLabel}</div>
          <div>
            {t.profile.record.map((r) => (
              <div class="log-line">
                <span class="log-date">{r.date}</span>
                <div>
                  <div class="text-fg font-semibold text-sm leading-snug">{r.role}</div>
                  <div class="text-muted text-xs font-mono mt-0.5">{r.company}</div>
                  <div class="text-muted text-xs mt-1.5 leading-relaxed">{r.note}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mt-4">
          {t.profile.credentials.map((c) => (
            <div class="glass-card reveal p-4!">
              <Icon name={c.icon} size={20} class="text-primary mb-2" />
              <div class="text-fg font-semibold text-sm leading-snug">{c.title}</div>
              <div class="text-primary text-xs font-mono mt-0.5">{c.place}</div>
              <p class="text-muted text-xs mt-2 leading-relaxed">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
