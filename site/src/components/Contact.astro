---
import { getTranslations, type Locale } from '../i18n';
import Icon from './Icon.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
const contact = t.contact.info;
---

<section id="contact" data-station="6" class="section-padding relative">
  <div class="container mx-auto px-6">
    <header class="max-w-3xl mb-14 reveal">
      <div class="flex items-center gap-3 mb-5">
        <span class="station-chip">[ 06 / 06 ]</span>
        <span class="kicker">{t.contact.kicker}</span>
      </div>
      <h2 class="font-display text-4xl md:text-6xl font-bold text-fg">
        {t.contact.title.prefix}<span class="gradient-text">{t.contact.title.highlight}</span>
      </h2>
      <p class="mt-4 text-lg text-muted">{t.contact.subtitle}</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
        {t.contact.expectations.map((e) => (
          <span class="mono-note"><span class="text-accent">✓</span> {e}</span>
        ))}
      </div>
    </header>

    <div class="max-w-6xl grid lg:grid-cols-5 gap-8">
      <!-- Channels -->
      <div class="lg:col-span-2 space-y-3">
        {[
          { icon: 'Mail', label: contact.email, href: `mailto:${contact.email}` },
          { icon: 'Phone', label: contact.phone, href: `tel:${contact.phone}` },
          { icon: 'MessageCircle', label: 'WhatsApp', href: contact.whatsapp },
          { icon: 'Linkedin', label: 'LinkedIn', href: contact.linkedin },
          { icon: 'Github', label: 'GitHub', href: contact.github },
        ].map((c) => (
          <a href={c.href} target={c.href.startsWith('mailto') || c.href.startsWith('tel') ? undefined : '_blank'} rel="noopener noreferrer"
            class="glass-card reveal py-3.5! flex items-center gap-3.5 text-muted hover:text-fg transition-colors group">
            <span class="w-9 h-9 rounded-lg border border-border-strong flex items-center justify-center bg-card-solid shrink-0 group-hover:border-primary transition-colors">
              <Icon name={c.icon} size={17} class="text-primary" />
            </span>
            <span class="text-sm font-medium truncate">{c.label}</span>
            <Icon name="ArrowUpRight" size={14} class="ms-auto opacity-0 group-hover:opacity-100 transition-opacity text-primary" />
          </a>
        ))}
        <p class="mono-note pt-3 ps-1">Avg. reply &lt; 24h · Cairo (UTC+2)</p>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        <div class="glass-card reveal">
          <h3 class="font-display text-xl font-semibold text-fg mb-6">{t.contact.form.title}</h3>
          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
            novalidate
            data-sending={t.contact.form.sending}
            data-success={t.contact.form.success}
            data-error={t.contact.form.error}
            data-captcha-error={t.contact.form.captcha}
          >
            <input type="hidden" name="access_key" value="a0e8105f-2846-436b-a137-7737e6e21c28" />
            <input type="hidden" name="redirect" value="https://m3taz-ahmed.github.io" />
            <input type="hidden" name="subject" value="New pipeline inquiry — m3taz-ahmed.github.io" />
            <input type="hidden" name="from_name" value="Portfolio Contact" />
            <div class="absolute -left-[9999px] top-auto w-px h-px overflow-hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_ts" id="form-ts" value="" />

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="mono-note block mb-1.5">{t.contact.form.name}</label>
                <input
                  id="name" type="text" name="name" required autocomplete="name" minlength="2"
                  placeholder={t.contact.form.name}
                  class="w-full bg-card border border-border rounded-lg px-4 py-3 text-fg placeholder-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
              <div>
                <label for="email" class="mono-note block mb-1.5">{t.contact.form.email}</label>
                <input
                  id="email" type="email" name="email" required autocomplete="email"
                  placeholder={t.contact.form.email}
                  class="w-full bg-card border border-border rounded-lg px-4 py-3 text-fg placeholder-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="project-type" class="mono-note block mb-1.5">{t.contact.form.type}</label>
              <select
                id="project-type" name="project_type"
                class="w-full bg-card border border-border rounded-lg px-4 py-3 text-fg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
              >
                {t.contact.form.typeOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </div>

            <div>
              <label for="message" class="mono-note block mb-1.5">Message</label>
              <textarea
                id="message" name="message" rows="5" required minlength="10"
                placeholder={t.contact.form.message}
                class="w-full bg-card border border-border rounded-lg px-4 py-3 text-fg placeholder-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-y"
              ></textarea>
            </div>

            <div class="h-captcha" data-captcha="true" data-theme="dark" data-lang={locale}></div>

            <button type="submit" id="submit-btn" class="btn btn-primary w-full font-mono tracking-wide">
              <span>{t.contact.form.submit}</span>
              <Icon name="Send" size={15} />
            </button>

            <p id="form-status" class="text-sm text-center text-primary hidden font-mono" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const ts = document.getElementById('form-ts');
    if (ts) ts.value = String(Date.now());
  })();
</script>
<script src="https://web3forms.com/client/script.js" async defer></script>
