---
import '../styles/global.css';
import { getTranslations, type Locale } from '../i18n';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);

const site = t.seo.url;
const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;
const ogImage = image ?? `${site}${t.seo.image}`;
const canonical = new URL(Astro.url.pathname, site).toString();
const enUrl = new URL(Astro.url.pathname.replace(/^\/ar\/?/, '/'), site).toString();
const arUrl = new URL(`/ar${Astro.url.pathname.replace(/^\/ar/, '') || '/'}`, site).toString();
const isAr = locale === 'ar';
const alternateUrls = [
  { lang: 'en', href: enUrl },
  { lang: 'ar', href: arUrl },
  { lang: 'x-default', href: enUrl },
];

// Build JSON-LD graph: Person + ItemList of projects
const projectItems = (t.projects.items || []).slice(0, 10).map((p: any, i: number) => ({
  '@type': 'CreativeWork',
  position: i + 1,
  name: p.title,
  description: p.desc,
  url: p.link || p.caseStudyLink || site,
  keywords: (p.tags || []).join(', '),
  image: p.image ? `${site}${p.image}` : undefined,
}));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site}#person`,
      name: t.seo.author,
      jobTitle: t.hero.typewriter[0],
      url: site,
      sameAs: [t.contact.info.github, t.contact.info.linkedin],
      knowsAbout: ['aiZee', 'Sovereign AI Architecture', 'Agentic Workflows', 'Laravel 13', 'PHP 8.5', 'Filament v5', 'System Architecture', 'Internal Audit', 'MCP', 'Qdrant'],
      image: `${site}${t.seo.image}`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: t.seo.title,
      inLanguage: locale,
      author: { '@id': `${site}#person` },
    },
    {
      '@type': 'ItemList',
      name: 'Projects',
      itemListElement: projectItems,
    },
  ],
};
---

<!DOCTYPE html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={t.seo.author} />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0f" media="(prefers-color-scheme: dark)" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
    {alternateUrls.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/moataz-ahmed-pic.jpg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    {alternateUrls.filter(a => a.lang !== 'x-default').map((alt) => (
      <meta property="og:locale:alternate" content={alt.lang === 'ar' ? 'ar_EG' : 'en_US'} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        const stored = (() => {
          try { return localStorage.getItem('theme'); } catch { return null; }
        })();
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <title>{pageTitle}</title>
  </head>

  <body class="font-sans antialiased relative min-h-screen">
    <canvas id="particles-canvas" aria-hidden="true"></canvas>

    <Nav />

    <main id="main" class="relative z-10">
      <slot />
    </main>

    <Footer />

    <a
      href="#main"
      id="back-to-top"
      class="fixed bottom-6 end-6 z-50 w-12 h-12 rounded-full flex items-center justify-center opacity-0 invisible transition-all duration-300 hover:-translate-y-1"
      aria-label={locale === 'ar' ? 'العودة للأعلى' : 'Back to top'}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"/>
      </svg>
    </a>

    <script is:inline src="/app.js"></script>
  </body>
</html>
