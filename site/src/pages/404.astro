---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<Layout title={t.notFound.title} description={t.notFound.message}>
  <section class="min-h-[70vh] flex items-center justify-center bg-grid">
    <div class="text-center px-6">
      <div class="kicker justify-center mb-6">ERR // 404</div>
      <h1 class="font-display text-8xl md:text-9xl font-bold gradient-text">404</h1>
      <p class="font-display text-2xl text-fg mt-4 mb-2">{t.notFound.title}</p>
      <p class="text-muted mb-8 font-mono text-sm">{t.notFound.message}</p>
      <a href="/" class="btn btn-primary">{t.notFound.back}</a>
    </div>
  </section>
</Layout>
