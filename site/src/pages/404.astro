---
import Layout from '../layouts/Layout.astro';
import { getTranslations, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = getTranslations(locale);
---

<Layout title={t.notFound.title} description={t.notFound.message}>
  <section class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-9xl font-black gradient-text">404</h1>
      <p class="text-2xl text-heading mt-4 mb-2">{t.notFound.title}</p>
      <p class="text-dim mb-8">{t.notFound.message}</p>
      <a href="/" class="btn btn-primary">{t.notFound.back}</a>
    </div>
  </section>
</Layout>
